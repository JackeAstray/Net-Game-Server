# 敏感配置环境变量参考清单（凭据治理 P1）
#
# 说明：ConfigHelper 已接入 Microsoft.Extensions.Configuration 环境变量源，
# 环境变量优先于 appsettings.json 中的同名键。配置键中的 ":" 在环境变量名里写成 "__"。
# 本文件仅供部署参考，不会被程序自动加载；请按你的部署方式（systemd/supervisor/.env 导入）设置。
#
# 警告：下列各项均为生产敏感凭据，严禁写入 appsettings.json 或提交到 git。

# ── Login 节点 ────────────────────────────────────────────────────────────────
# HTTP 管理/公开 API 密钥（逗号分隔可多个；为空时所有非公开 API 被拒绝）
# 注意：禁止使用 CHANGE_ME_* 之类的模板占位值——程序启动时会拒绝占位符密钥（fail-closed）。
HttpApiKeys=

# 找回密码邮件发送账号（网易 163 SMTP）；为空时不发送邮件（找回密码功能不可用，不报错）
SMTP__Account=
SMTP__Password=

# 登录令牌签名密钥（缺失时程序回退为进程内随机值，重启后所有登录态失效；
# 配置为占位符/示例值或短于 16 字符时启动即失败。生产环境必须配置 ≥32 字符强随机串）
TokenSecret=

# ── DB 节点 ───────────────────────────────────────────────────────────────────
# MySQL 连接串（未配置时 DB 节点启动即抛错，禁止硬编码默认连接）
ConnectionStrings__MySqlConnection=

# ── 内部节点共享密钥（所有节点必须一致；长度 >= 16；缺失/占位符启动被拒）──────
CenterNodeSharedSecret=

# ── 可选 ──────────────────────────────────────────────────────────────────────
# Admin:DefaultPassword=（未配置时自动生成随机密码并仅控制台一次性输出）
# Admin:DefaultPassword=

# ── docker compose（deploy/docker-compose.yml 读取） ───────────────────────────
# compose 默认值是**假**的开发口令（netgame-dev-db-pass），生产必须在 .env 覆盖。
# 注意：若 mysql-data / pg-data 卷已用旧口令初始化过，改这里后需 down -v 重置卷才生效。
MYSQL_PASSWORD=
POSTGRES_PASSWORD=
MYSQL_ROOT_PASSWORD=
GRAFANA_ADMIN_PASSWORD=

# ── 本地开发更推荐：appsettings.Local.json ─────────────────────────────────────
# 上面的环境变量需要手工注入（或由 .env 导入）。纯本地开发更省事的等价做法，是写节点目录下
# 的 appsettings.Local.json —— 它已被 .gitignore 忽略，且由项目文件自动拷贝到输出目录。
# 优先级：appsettings.json < appsettings.Local.json < 环境变量(无前缀) < 环境变量(NG_)。
#   NetGameServer/DB/appsettings.Local.json    -> {"ConnectionStrings":{"MySqlConnection":"Server=...;Pwd=...;"}}
#   NetGameServer/Login/appsettings.Local.json -> {"SMTP":{"Account":"...","Password":"..."}}
# 注意：受版本控制的 appsettings.json 现在只放 CHANGE_ME 占位符，缺失真实值时节点会 fail-closed 报错。
