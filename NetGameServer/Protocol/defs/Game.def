<?xml version="1.0" encoding="utf-8"?>
<!--
    游戏服协议（已迁移，占位文件）
    ============================================================
    本 .def 的消息/结构体已全部迁移到方案 A：Framework/Framework.Protocol/Messages/GameMessages.cs，
    以 C# [GameMessage]/[GameStruct] 声明，由 Framework.Protocol.Generator 源生成器在编译期生成
    MessageIds / RouterTable / IGameMessage 管线 / ProtocolManifest.json。

    保留本文件的目的：
      1. 记录游戏服链路的 ID 段约定（50000-59999 好友/社交；60000-69999 聊天）；
      2. 保持 Protocol/defs/ 目录的协议分段结构。
    客户端代码由 ClientGen 从 ProtocolManifest.Json 生成，无需本文件。

    ID 段约定：
      - 60001~60003  聊天（ChatSend/ChatSendResult/ChatNotify）
      - 50001~50028  好友/黑名单/好友申请/游戏邀请
-->
<Protocol name="Game" version="1">
  <!-- 已迁移到 [GameMessage]/[GameStruct]，见 Framework.Protocol/Messages/GameMessages.cs -->
</Protocol>
