<?xml version="1.0" encoding="utf-8"?>
<!--
    游戏服协议定义（好友/聊天/背包等社交链路）
    id 范围约定：50000-59999 好友/社交；60000-69999 聊天
-->
<Protocol name="Game" version="1">

  <!-- ==== 聊天 60000-69999 ==== -->
  <Message id="60001" name="ChatSend" target="Game" reply="60002">
    <Field name="SenderId" type="int32" />
    <Field name="SenderUniqueId" type="string" />
    <Field name="SenderName" type="string" />
    <Field name="ReceiverId" type="int32" optional="true" />
    <Field name="ReceiverUniqueId" type="string" />
    <Field name="Channel" type="int32" />
    <Field name="RoomId" type="string" />
    <Field name="Content" type="string" />
  </Message>

  <Message id="60002" name="ChatSendResult" target="Game">
    <Field name="Success" type="bool" />
    <Field name="Message" type="string" />
  </Message>

  <Message id="60003" name="ChatNotify" target="Game">
    <Field name="MessageId" type="int64" />
    <Field name="SenderId" type="int32" />
    <Field name="SenderUniqueId" type="string" />
    <Field name="SenderName" type="string" />
    <Field name="ReceiverId" type="int32" />
    <Field name="ReceiverUniqueId" type="string" />
    <Field name="Channel" type="int32" />
    <Field name="Content" type="string" />
    <Field name="SendTime" type="int64" />
  </Message>

  <!-- ==== 好友 50000-59999 ==== -->
  <Message id="50001" name="FriendAdd" target="Game" reply="50002">
    <Field name="TargetUniqueId" type="string" />
    <Field name="Remark" type="string" />
  </Message>

  <Message id="50002" name="FriendAddResult" target="Game">
    <Field name="Success" type="bool" />
    <Field name="Message" type="string" />
  </Message>

  <Message id="50003" name="FriendRemove" target="Game" reply="50004">
    <Field name="FriendUniqueId" type="string" />
  </Message>

  <Message id="50004" name="FriendRemoveResult" target="Game">
    <Field name="Success" type="bool" />
    <Field name="Message" type="string" />
  </Message>

  <Message id="50005" name="FriendSetRemark" target="Game" reply="50006">
    <Field name="FriendUniqueId" type="string" />
    <Field name="Remark" type="string" />
  </Message>

  <Message id="50006" name="FriendSetRemarkResult" target="Game">
    <Field name="Success" type="bool" />
    <Field name="Message" type="string" />
  </Message>

  <Message id="50007" name="FriendGetList" target="Game" reply="50008" />

  <Message id="50008" name="FriendListResult" target="Game">
    <Field name="Success" type="bool" />
    <Field name="Message" type="string" />
    <Field name="Friends" type="list:FriendInfo" />
  </Message>

  <Message id="50009" name="FriendInviteGame" target="Game" reply="50010">
    <Field name="FriendUniqueId" type="string" />
    <Field name="RoomId" type="string" />
    <Field name="SceneType" type="string" />
    <Field name="RoomName" type="string" />
  </Message>

  <Message id="50010" name="FriendInviteGameResult" target="Game">
    <Field name="Success" type="bool" />
    <Field name="Message" type="string" />
  </Message>

  <Message id="50011" name="FriendInviteGameNotify" target="Game">
    <Field name="InviterUniqueId" type="string" />
    <Field name="InviterNickname" type="string" />
    <Field name="RoomId" type="string" />
    <Field name="SceneType" type="string" />
    <Field name="RoomName" type="string" />
  </Message>

  <Message id="50012" name="BlacklistAdd" target="Game" reply="50013">
    <Field name="TargetUniqueId" type="string" />
  </Message>

  <Message id="50013" name="BlacklistAddResult" target="Game">
    <Field name="Success" type="bool" />
    <Field name="Message" type="string" />
  </Message>

  <Message id="50014" name="BlacklistRemove" target="Game" reply="50015">
    <Field name="TargetUniqueId" type="string" />
  </Message>

  <Message id="50015" name="BlacklistRemoveResult" target="Game">
    <Field name="Success" type="bool" />
    <Field name="Message" type="string" />
  </Message>

  <Message id="50016" name="BlacklistGetList" target="Game" reply="50017" />

  <Message id="50017" name="BlacklistListResult" target="Game">
    <Field name="Success" type="bool" />
    <Field name="Message" type="string" />
    <Field name="Blacklists" type="list:BlacklistInfo" />
  </Message>

  <Message id="50018" name="FriendApply" target="Game" reply="50019">
    <Field name="TargetUniqueId" type="string" />
    <Field name="Message" type="string" />
  </Message>

  <Message id="50019" name="FriendApplyResult" target="Game">
    <Field name="Success" type="bool" />
    <Field name="Message" type="string" />
  </Message>

  <Message id="50020" name="FriendApplyNotify" target="Game">
    <Field name="ApplyId" type="int64" />
    <Field name="RequesterUserId" type="int32" />
    <Field name="RequesterUniqueId" type="string" />
    <Field name="RequesterNickname" type="string" />
    <Field name="Message" type="string" />
    <Field name="CreateTimeUtc" type="int64" />
  </Message>

  <Message id="50021" name="FriendApplyList" target="Game" reply="50022" />

  <Message id="50022" name="FriendApplyListResult" target="Game">
    <Field name="Success" type="bool" />
    <Field name="Message" type="string" />
    <Field name="Applies" type="list:FriendApplyInfo" />
  </Message>

  <Message id="50023" name="FriendApplyHandle" target="Game" reply="50024">
    <Field name="ApplyId" type="int64" />
    <Field name="Accept" type="bool" />
  </Message>

  <Message id="50024" name="FriendApplyHandleResult" target="Game">
    <Field name="Success" type="bool" />
    <Field name="Message" type="string" />
  </Message>

  <Message id="50025" name="FriendOnlineStatusNotify" target="Game">
    <Field name="UserId" type="int32" />
    <Field name="UniqueId" type="string" />
    <Field name="IsOnline" type="bool" />
  </Message>

  <Message id="50026" name="FriendInviteGameAck" target="Game" reply="50027">
    <Field name="InviterUniqueId" type="string" />
    <Field name="RoomId" type="string" />
    <Field name="Accept" type="bool" />
    <Field name="Reason" type="string" />
  </Message>

  <Message id="50027" name="FriendInviteGameAckResult" target="Game">
    <Field name="Success" type="bool" />
    <Field name="Message" type="string" />
  </Message>

  <Message id="50028" name="FriendInviteGameAckNotify" target="Game">
    <Field name="InviteeUniqueId" type="string" />
    <Field name="InviteeNickname" type="string" />
    <Field name="RoomId" type="string" />
    <Field name="Accept" type="bool" />
    <Field name="Reason" type="string" />
  </Message>

  <!-- ==== 社交数据结构（内部引用类型） ==== -->
  <Struct name="FriendInfo">
    <Field name="FriendUserId" type="int32" />
    <Field name="FriendUniqueId" type="string" />
    <Field name="Nickname" type="string" />
    <Field name="Remark" type="string" />
    <Field name="IsOnline" type="bool" />
  </Struct>

  <Struct name="BlacklistInfo">
    <Field name="BlockedUserId" type="int32" />
    <Field name="BlockedUniqueId" type="string" />
    <Field name="BlockedNickname" type="string" />
    <Field name="AddTime" type="int64" />
  </Struct>

  <Struct name="FriendApplyInfo">
    <Field name="ApplyId" type="int64" />
    <Field name="RequesterUserId" type="int32" />
    <Field name="RequesterUniqueId" type="string" />
    <Field name="RequesterNickname" type="string" />
    <Field name="Message" type="string" />
    <Field name="Status" type="string" />
    <Field name="CreateTimeUtc" type="int64" />
  </Struct>

</Protocol>
