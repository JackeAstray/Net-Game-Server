<?xml version="1.0" encoding="utf-8"?>
<!--
    登录链路协议（已迁移，占位文件）
    ============================================================
    本 .def 的消息已全部迁移到方案 A：Framework/Framework.Protocol/Messages/LoginMessages.cs，
    以 C# [GameMessage] 属性声明，由 Framework.Protocol.Generator 源生成器在编译期生成
    MessageIds / RouterTable / IGameMessage 管线 / ProtocolManifest.json。

    保留本文件的目的：
      1. 记录登录链路的 ID 段约定（10000-19999），防止后续新消息误用该段；
      2. 保持 Protocol/defs/ 目录的协议分段结构。
    迁移完成后，非 internal 消息已加入 Framework.Protocol.Generated.ProtocolManifest.Json，
    ClientGen 会从该清单生成客户端代码，无需本文件。

    ID 段约定：
      - 10000   PlayerDisconnect（internal, All）
      - 10001~10013  登录/注册/登出/改密/改名/找回密码 客户端链路
      - 10014   PlayerSessionResume（internal, Battle）
-->
<Protocol name="Login" version="1">
  <!-- 已迁移到 [GameMessage]，见 Framework.Protocol/Messages/LoginMessages.cs -->
</Protocol>
