<!--
    Center/调度服务器协议定义（已迁移，占位文件）
    ============================================================
    本 .def 的消息/结构体已全部迁移到方案 A：Framework/Framework.Protocol/Messages/CenterMessages.cs，
    以 C# [GameMessage]/[GameStruct] 声明，由 Framework.Protocol.Generator 源生成器在编译期生成
    MessageIds / RouterTable / IGameMessage 管线 / ProtocolManifest.json。

    保留本文件的目的：
      1. 记录调度服链路的 ID 段约定（30000-39999 客户端消息；90000-90999 内部节点通信）；
      2. 保持 Protocol/defs/ 目录的协议分段结构。
    客户端代码由 ClientGen 从 ProtocolManifest.Json 生成，无需本文件。
-->
<Protocol name="Center" version="1">
  <!-- 已迁移到 [GameMessage]/[GameStruct]，见 Framework.Protocol/Messages/CenterMessages.cs -->
</Protocol>
