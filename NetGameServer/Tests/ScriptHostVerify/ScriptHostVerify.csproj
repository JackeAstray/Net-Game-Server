<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>ScriptHostVerify</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Framework\Framework.Scripting\Framework.Scripting.csproj" />
    <ProjectReference Include="..\..\Framework\Framework.Entity\Framework.Entity.csproj" />
    <ProjectReference Include="..\..\Framework\Framework.Tick\Framework.Tick.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Always：热更新测试会修改输出目录的脚本副本，失败退出时可能残留污染；
         强制每次构建从源目录覆盖，保证验证套件可重复运行。 -->
    <None Include="..\..\GameLogic\scripts\*.csx" Link="scripts\%(Filename)%(Extension)" CopyToOutputDirectory="Always" />
  </ItemGroup>

</Project>
