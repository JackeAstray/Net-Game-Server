<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>ClientGenVerify</RootNamespace>
    <AssemblyName>ClientGenVerify</AssemblyName>
    <IsTestProject>true</IsTestProject>
    <GenerateProgramFile>false</GenerateProgramFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- 服务器真实 MemoryPack 类（被验证的基准） -->
    <ProjectReference Include="..\..\Framework\Framework.Protocol\Framework.Protocol.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 生成器产出的客户端 C#（MemoryPack 兼容编解码）直接链接进来，编译即验证全部 Unity 产物 -->
    <Compile Include="..\..\Tools\ClientGen\Output\Unity\MessageIds.cs" Link="Gen\MessageIds.cs" />
    <Compile Include="..\..\Tools\ClientGen\Output\Unity\MemoryPackCodec.cs" Link="Gen\MemoryPackCodec.cs" />
    <Compile Include="..\..\Tools\ClientGen\Output\Unity\Messages.cs" Link="Gen\Messages.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
