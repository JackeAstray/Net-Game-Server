<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <!-- 本仓库全系 net10.0，编译器宿主即 .NET 10（SDK 10.0.400），
         RS1041 的"跨目标框架不可预测"在此不适用，抑制即可。
         RS2008 要求为发布到 NuGet 的分析器加发布跟踪，本生成器仅仓库内置，无需。 -->
    <NoWarn>$(NoWarn);RS1041;RS2008</NoWarn>
    <RootNamespace>Framework.Protocol.Generator</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" PrivateAssets="all" />
  </ItemGroup>

</Project>
