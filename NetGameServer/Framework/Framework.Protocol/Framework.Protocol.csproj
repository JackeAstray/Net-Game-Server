<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Framework.Protocol</RootNamespace>
    <AssemblyName>Framework.Protocol</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MemoryPack" Version="1.21.4" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Framework.Core\Framework.Core.csproj" />
  </ItemGroup>

  <!-- 方案 A 源生成器：读取 [GameMessage]/[GameStruct]，编译期产出 MessageIds/RouterTable/IGameMessage 管线/ProtocolManifest -->
  <ItemGroup>
    <ProjectReference Include="..\Framework.Protocol.Generator\Framework.Protocol.Generator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
